#!/usr/bin/env bash
# Pre-commit hook: runs the repository test suite.
# Install: ln -sf ../../scripts/pre-commit .git/hooks/pre-commit

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

echo "Running repository tests..."
if ! uv run pytest "$REPO_ROOT/tests/" -q; then
    echo "Python tests failed. Commit aborted."
    exit 1
fi

echo "All tests passed."
