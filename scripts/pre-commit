#!/usr/bin/env bash
# Pre-commit hook: runs the repository test suite.
# Install: ln -sf ../../scripts/pre-commit .git/hooks/pre-commit

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

echo "Validating Claude plugin and marketplace manifests..."
if ! claude plugin validate "$REPO_ROOT" --strict; then
    echo "Claude plugin validation failed. Commit aborted."
    exit 1
fi

echo "Running repository tests..."
if ! uv run --frozen pytest "$REPO_ROOT/tests/" -q; then
    echo "Python tests failed. Commit aborted."
    exit 1
fi

echo "Claude validation and repository tests passed."
