#!/usr/bin/env bash
# codex-ponytail — make a worktree and print the command to open Codex in it
# with ponytail loaded for that invocation.
#
# Codex has no session-only equivalent of Claude's --plugin-dir. This launcher
# injects the pinned ponytail SKILL.md through Codex's per-invocation
# developer_instructions override instead. It does not install or enable a
# plugin, so unrelated Codex sessions stay unaffected.
#
# This does not launch anything. It prepares the worktree and hands you the
# command, so you start it in whatever window you want it in.
#
# Usage:
#   codex-ponytail <name> [<base-ref>]   worktree .worktrees/<name>, branch <name>
#
# Flags:
#   --dry-run   print what would happen, change nothing
#
# Env:
#   CODEX_PONYTAIL_BINARY   Codex executable. Defaults to codex from PATH.

set -euo pipefail

# Share the audited clone with claude-ponytail rather than downloading a second
# identical checkout.
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/claude-ponytail"
VENDOR="$CACHE/ponytail"
CODEX="${CODEX_PONYTAIL_BINARY:-$(command -v codex || true)}"
PONYTAIL_URL="${CODEX_PONYTAIL_URL:-https://github.com/DietrichGebert/ponytail.git}"

# Pinned to the commit audited on 2026-07-28. Moving this pin requires a fresh
# audit of Ponytail's Codex manifest, hooks, and skills.
# Overridable by env for hermetic tests only.
PONYTAIL_SHA="${CODEX_PONYTAIL_SHA:-16f29800fd2681bdf24f3eb4ccffe38be3baec6b}"

DRY_RUN=false

die() { printf 'codex-ponytail: %s\n' "$1" >&2; exit 1; }

run() {
    if $DRY_RUN; then printf '+ %s\n' "$*" >&2; else "$@"; fi
}

# Single-quoted shell words parse identically in Bash and Fish.
shell_quote() {
    local value="$1"
    printf "'%s'" "${value//\'/\'\\\'\'}"
}

main_checkout() {
    local common
    common=$(git rev-parse --git-common-dir 2>/dev/null) || die "not inside a git repository"
    case "$common" in /*) ;; *) common="$PWD/$common" ;; esac
    (cd "$(dirname "$common")" && pwd)
}

safe_rm() {
    local target="${1:-}"
    case "$target" in
        "$CACHE"/?*) ;;
        *) die "refusing to remove '$target': not inside $CACHE" ;;
    esac
    rm -rf -- "$target"
}

ensure_ponytail() {
    if [ -d "$VENDOR/.git" ] \
       && [ "$(git -C "$VENDOR" rev-parse HEAD 2>/dev/null)" = "$PONYTAIL_SHA" ]; then
        return 0
    fi
    printf 'fetching ponytail at %s\n' "${PONYTAIL_SHA:0:12}" >&2

    if $DRY_RUN; then
        printf '+ clone %s -> %s at %s\n' "$PONYTAIL_URL" "$VENDOR" "${PONYTAIL_SHA:0:12}" >&2
        return 0
    fi

    mkdir -p "$CACHE"
    local staging
    staging=$(mktemp -d "$CACHE/.staging.XXXXXX")
    if ! git clone --quiet "$PONYTAIL_URL" "$staging/new" \
       || ! git -C "$staging/new" checkout --quiet --detach "$PONYTAIL_SHA"; then
        safe_rm "$staging"
        die "could not fetch ponytail ${PONYTAIL_SHA:0:12} from $PONYTAIL_URL (existing clone left intact)"
    fi

    if [ -e "$VENDOR" ]; then
        mv "$VENDOR" "$staging/old"
    fi
    mv "$staging/new" "$VENDOR"
    safe_rm "$staging"
}

lfs_guard() {
    local wt="$1" f
    git -C "$wt" lfs env >/dev/null 2>&1 || return 0
    git -C "$wt" diff --name-only -z |
    while IFS= read -r -d '' f; do
        if git -C "$wt" check-attr filter -- "$f" 2>/dev/null | grep -q 'filter: lfs'; then
            git -C "$wt" update-index --assume-unchanged -- "$f"
        fi
    done
}

is_worktree_root() {
    local wt="$1" git_root physical_root
    git_root=$(git -C "$wt" rev-parse --show-toplevel 2>/dev/null) || return 1
    physical_root=$(cd "$wt" && pwd -P) || return 1
    [ "$git_root" = "$physical_root" ]
}

require_worktrees_ignored() {
    local root="$1" error status
    if error=$(git -C "$root" check-ignore -q .worktrees/probe 2>&1); then
        return 0
    else
        status=$?
    fi

    if [ "$status" -eq 1 ]; then
        die ".worktrees/ is not gitignored in $root — add it and commit first"
    fi
    [ -z "$error" ] || printf '%s\n' "$error" >&2
    die "could not check whether .worktrees is ignored in $root (git exited $status)"
}

main() {
    local name="$1" base="${2:-HEAD}"
    local root wt cmd actual_branch skill_file

    git check-ref-format --branch "$name" >/dev/null 2>&1 \
        || die "invalid worktree name '$name': must also be a valid git branch name"

    root=$(main_checkout)
    require_worktrees_ignored "$root"
    [ -x "$CODEX" ] || die "codex executable not found or not executable: ${CODEX:-<empty>}"

    ensure_ponytail
    skill_file="$VENDOR/skills/ponytail/SKILL.md"
    $DRY_RUN || [ -r "$skill_file" ] \
        || die "ponytail skill not readable at $skill_file"

    wt="$root/.worktrees/$name"
    if [ -d "$wt" ]; then
        is_worktree_root "$wt" \
            || die "existing path is not a registered git worktree: $wt"
        actual_branch=$(git -C "$wt" branch --show-current)
        [ "$actual_branch" = "$name" ] \
            || die "existing worktree uses branch '${actual_branch:-detached HEAD}', expected '$name': $wt"
        printf 'reusing existing worktree %s\n' "$wt" >&2
    elif git -C "$root" show-ref --verify --quiet "refs/heads/$name"; then
        run git -C "$root" worktree add "$wt" "$name"
    else
        run git -C "$root" worktree add "$wt" -b "$name" "$base"
    fi
    $DRY_RUN || lfs_guard "$wt"

    cmd="$(shell_quote "$CODEX") -C $(shell_quote "$wt")"
    cmd+=" -c \"developer_instructions=\$(sed -n '1,\$p' $(shell_quote "$skill_file"))\""

    printf '\nworktree : %s\n' "$wt"
    printf 'ponytail : %s (pinned, session-scoped instructions)\n' "${PONYTAIL_SHA:0:12}"
    printf 'remove   : git -C %s worktree remove %s\n' \
        "$(shell_quote "$root")" "$(shell_quote "$wt")"
    printf '\nrun this in the window you want it in:\n\n  %s\n\n' "$cmd"
}

POSITIONAL=()
while [ $# -gt 0 ]; do
    case "$1" in
        --dry-run) DRY_RUN=true; shift ;;
        -h|--help) sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        -*)        die "unknown option: $1" ;;
        *)         POSITIONAL+=("$1"); shift ;;
    esac
done

[ "${#POSITIONAL[@]}" -ge 1 ] || die "need a worktree name. Try --help"
[ "${#POSITIONAL[@]}" -le 2 ] || die "too many arguments: ${POSITIONAL[*]}"
main "${POSITIONAL[@]}"
