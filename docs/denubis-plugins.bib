@article{deganiCockpitChecklistsConcepts1993,
  title = {Cockpit {{Checklists}}: {{Concepts}}, {{Design}}, and {{Use}}},
  shorttitle = {Cockpit {{Checklists}}},
  author = {Degani, Asaf and Wiener, Earl L.},
  date = {1993-06},
