{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "uv run python \"${CLAUDE_PLUGIN_ROOT}/hooks/branch-bg.py\"",
            "timeout": 5,
            "suppressOutput": true
          }
        ]
      }
    ]
  }
}
