{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/update-live-marker.py\"",
            "suppressOutput": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --no-config python \"${CLAUDE_PLUGIN_ROOT}/hooks/code-quality-guard.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
