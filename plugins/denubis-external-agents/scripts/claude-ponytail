#!/usr/bin/env bash
# claude-ponytail — create or reuse a worktree and launch Claude in it with
# Ponytail loaded.
#
# Ponytail (https://github.com/DietrichGebert/ponytail) is a "lazy senior dev"
# persona. It is loaded with --plugin-dir, which is session-scoped: it applies to
# the session you start and to nothing else. It is never installed, so your other
# sessions and subagents stay unaffected by its always-on hooks.
#
# Usage:
#   claude-ponytail <name> [<claude-args>...]
#
# Flags:
#   --dry-run   print what would happen, change nothing
#
# Env:
#   CLAUDE_PONYTAIL_CONFIG_DIR   run against a separate CLAUDE_CONFIG_DIR instead
#                                of your normal one. Unset by default.

set -euo pipefail

CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/claude-ponytail"
VENDOR="$CACHE/ponytail"
WRAPPER="${CLAUDE_PONYTAIL_WRAPPER:-$HOME/.claude/bin/claude-wrapper}"
CONFIG_DIR="${CLAUDE_PONYTAIL_CONFIG_DIR:-}"
PONYTAIL_URL="${CLAUDE_PONYTAIL_URL:-https://github.com/DietrichGebert/ponytail.git}"

# Pinned to upstream v4.9.0 after audit on 2026-08-15. Relative to the prior
# audited pin, this tag changes version metadata only. At that audit, upstream
# main `2ed6c52` was three commits ahead, limited to Claude.ai validation, VS Code
# Copilot, and Grok Build; the shipped skill bodies were unchanged. Moving this
# pin obliges a fresh audit: Ponytail ships always-on SessionStart/SubagentStart
# hooks and a nudge that asks the agent to edit your settings.json.
# Overridable by env for testing only. Overriding it in real use defeats the
# audit: point it somewhere unaudited and you get unaudited hooks.
PONYTAIL_SHA="${CLAUDE_PONYTAIL_SHA:-0a4dd63ad4541f4f655c4108a295916f3c1d8fda}"

DRY_RUN=false
PONYTAIL_STAGING=""
PONYTAIL_OLD_MOVED=false

die() { printf 'claude-ponytail: %s\n' "$1" >&2; exit 1; }

run() {
    if $DRY_RUN; then printf '+ %s\n' "$*" >&2; else "$@"; fi
}

# Single-quoted shell words parse identically in Bash and Fish. Unlike Bash
# printf %q, this never emits Bash-only $'...' syntax for embedded newlines.
shell_quote() {
    local value="$1"
    printf "'%s'" "${value//\'/\'\\\'\'}"
}

# Worktrees belong under the MAIN checkout, never nested inside another worktree,
# so resolve through --git-common-dir rather than --show-toplevel.
main_checkout() {
    local common checkout
    common=$(git rev-parse --git-common-dir 2>/dev/null) || die "not inside a git repository"
    case "$common" in /*) ;; *) common="$PWD/$common" ;; esac
    checkout=$(cd "$(dirname "$common")" 2>/dev/null && pwd) \
        || die "could not resolve main checkout from git common directory '$common'"
    printf '%s\n' "$checkout"
}

# Every recursive delete in this script goes through here. It refuses any path
# that is not strictly inside $CACHE, so a bug or an empty variable cannot turn
# into `rm -rf /` or `rm -rf $HOME`. `--` stops a leading dash being read as a
# flag. Nothing outside the cache is ever deleted by this script.
safe_rm() {
    local target="${1:-}"
    case "$target" in
        "$CACHE"/?*) ;;
        *) die "refusing to remove '$target': not inside $CACHE" ;;
    esac
    rm -rf -- "$target"
}

ponytail_cache_valid() {
    local head state
    [ -d "$VENDOR/.git" ] || return 1
    head=$(git -C "$VENDOR" rev-parse HEAD 2>/dev/null) || return 1
    [ "$head" = "$PONYTAIL_SHA" ] || return 1
    state=$(git -C "$VENDOR" status --porcelain=v1 --untracked-files=all \
        --ignored=matching 2>/dev/null) || return 1
    [ -z "$state" ]
}

cleanup_ponytail_swap() {
    local status=$?
    trap - EXIT HUP INT TERM

    if [ -n "$PONYTAIL_STAGING" ] && [ -d "$PONYTAIL_STAGING" ]; then
        if $PONYTAIL_OLD_MOVED \
           && [ ! -e "$VENDOR" ] \
           && [ ! -L "$VENDOR" ] \
           && [ -e "$PONYTAIL_STAGING/old" ]; then
            if ! mv -- "$PONYTAIL_STAGING/old" "$VENDOR"; then
                printf 'claude-ponytail: could not restore previous cache; recover it from %s\n' \
                    "$PONYTAIL_STAGING/old" >&2
                exit "$status"
            fi
        fi
        safe_rm "$PONYTAIL_STAGING"
    fi
    exit "$status"
}

ensure_ponytail() {
    if ponytail_cache_valid; then
        return 0
    fi
    printf 'fetching ponytail at %s\n' "${PONYTAIL_SHA:0:12}" >&2

    if $DRY_RUN; then
        printf '+ clone %s -> %s at %s\n' "$PONYTAIL_URL" "$VENDOR" "${PONYTAIL_SHA:0:12}" >&2
        return 0
    fi

    mkdir -p "$CACHE"
    command -v flock >/dev/null 2>&1 \
        || die "flock is required to update the ponytail cache safely"
    local lock_fd
    exec {lock_fd}>"$CACHE/.lock"
    flock -x "$lock_fd"

    # Another launcher may have populated the cache while this one waited.
    if ponytail_cache_valid; then
        exec {lock_fd}>&-
        return 0
    fi

    PONYTAIL_STAGING=$(mktemp -d "$CACHE/.staging.XXXXXX")
    PONYTAIL_OLD_MOVED=false
    trap cleanup_ponytail_swap EXIT
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM

    # Fetch into staging and swap only once the pinned commit is checked out, so
    # a failed or interrupted fetch leaves an existing good clone untouched. The
    # previous ordering deleted first and cloned second, which meant a dropped
    # network connection cost you a working clone.
    if ! git clone --quiet "$PONYTAIL_URL" "$PONYTAIL_STAGING/new" \
       || ! git -C "$PONYTAIL_STAGING/new" checkout --quiet --detach "$PONYTAIL_SHA"; then
        die "could not fetch ponytail ${PONYTAIL_SHA:0:12} from $PONYTAIL_URL (existing clone left intact)"
    fi

    if [ -e "$VENDOR" ] || [ -L "$VENDOR" ]; then
        # Set this before the move so the EXIT trap also covers a signal arriving
        # in the narrow interval immediately after the move succeeds.
        PONYTAIL_OLD_MOVED=true
        mv -- "$VENDOR" "$PONYTAIL_STAGING/old"
    fi
    mv -- "$PONYTAIL_STAGING/new" "$VENDOR"
    safe_rm "$PONYTAIL_STAGING"
    PONYTAIL_STAGING=""
    PONYTAIL_OLD_MOVED=false
    trap - EXIT HUP INT TERM
    exec {lock_fd}>&-
}

# Git LFS and worktrees interact badly: LFS-tracked files show as modified because
# the filter driver transforms content differently in a worktree, which makes
# pre-commit's stash restore fail and aborts the commit. Mark them
# assume-unchanged so that never happens.
lfs_guard() {
    local wt="$1" f
    git -C "$wt" lfs env >/dev/null 2>&1 || return 0
    git -C "$wt" diff --name-only -z |
    while IFS= read -r -d '' f; do
        if git -C "$wt" check-attr filter -- "$f" 2>/dev/null | grep -q 'filter: lfs'; then
            git -C "$wt" update-index --assume-unchanged -- "$f"
        fi
    done
}

resolved_common_dir() {
    local at="$1" common
    common=$(git -C "$at" rev-parse --git-common-dir 2>/dev/null) || return 1
    case "$common" in /*) ;; *) common="$at/$common" ;; esac
    (cd "$common" 2>/dev/null && pwd -P)
}

is_worktree_root() {
    local wt="$1" root="$2"
    local git_root physical_git_root physical_root actual_common expected_common
    git_root=$(git -C "$wt" rev-parse --show-toplevel 2>/dev/null) || return 1
    physical_git_root=$(cd "$git_root" 2>/dev/null && pwd -P) || return 1
    physical_root=$(cd "$wt" && pwd -P) || return 1
    [ "$physical_git_root" = "$physical_root" ] || return 1
    actual_common=$(resolved_common_dir "$wt") || return 1
    expected_common=$(resolved_common_dir "$root") || return 1
    [ "$actual_common" = "$expected_common" ]
}

completion_worktree_names() {
    local root field wt branch prefix
    root=$(main_checkout 2>/dev/null) || return 0
    prefix="$root/.worktrees/"
    wt=""
    branch=""

    while IFS= read -r -d '' field; do
        case "$field" in
            worktree\ *) wt="${field#worktree }" ;;
            branch\ refs/heads/*) branch="${field#branch refs/heads/}" ;;
            "")
                if [[ "$wt" == "$prefix"?* \
                      && -d "$wt" \
                      && ! -L "$wt" ]] \
                   && is_worktree_root "$wt" "$root"; then
                    printf '%s\n' "$branch"
                fi
                wt=""
                branch=""
                ;;
        esac
    done < <(
        git -C "$root" worktree list --porcelain -z 2>/dev/null
    )
}

registered_worktree_for_branch() {
    local root="$1" target="$2" prefix field wt branch
    prefix="$root/.worktrees/"
    wt=""

    while IFS= read -r -d '' field; do
        case "$field" in
            worktree\ *) wt="${field#worktree }" ;;
            branch\ refs/heads/*)
                branch="${field#branch refs/heads/}"
                if [[ "$branch" == "$target" && "$wt" == "$prefix"?* ]]; then
                    printf '%s\n' "$wt"
                    return 0
                fi
                ;;
            "") wt="" ;;
        esac
    done < <(
        git -C "$root" worktree list --porcelain -z 2>/dev/null
    )
    return 1
}

require_worktrees_ignored() {
    local root="$1" error status
    if error=$(git -C "$root" check-ignore -q .worktrees/probe 2>&1); then
        return 0
    else
        status=$?
    fi

    if [ "$status" -eq 1 ]; then
        die ".worktrees/ is not gitignored in $root — add it and commit first"
    fi
    [ -z "$error" ] || printf '%s\n' "$error" >&2
    die "could not check whether .worktrees is ignored in $root (git exited $status)"
}

main() {
    local name="$1"
    shift
    local root wt cmd argument actual_branch linked_worktree base

    if ! git check-ref-format --branch "$name" >/dev/null 2>&1 \
       || ! git check-ref-format "refs/heads/$name" >/dev/null 2>&1; then
        die "invalid worktree name '$name': must also be a valid literal git branch name"
    fi

    root=$(main_checkout)
    base=$(git rev-parse --verify 'HEAD^{commit}') \
        || die "could not resolve the caller checkout's HEAD"
    require_worktrees_ignored "$root"

    [ -x "$WRAPPER" ] || die "claude wrapper not executable at $WRAPPER"
    ensure_ponytail

    wt="$root/.worktrees/$name"
    if [ -d "$wt" ]; then
        is_worktree_root "$wt" "$root" \
            || die "existing path is not a registered git worktree: $wt"
        actual_branch=$(git -C "$wt" branch --show-current)
        [ "$actual_branch" = "$name" ] \
            || die "existing worktree uses branch '${actual_branch:-detached HEAD}', expected '$name': $wt"
        printf 'reusing existing worktree %s\n' "$wt" >&2
    elif git -C "$root" show-ref --verify --quiet "refs/heads/$name"; then
        if linked_worktree=$(registered_worktree_for_branch "$root" "$name"); then
            if [ ! -d "$linked_worktree" ] || [ -L "$linked_worktree" ]; then
                die "registered worktree is unavailable: $linked_worktree"
            fi
            is_worktree_root "$linked_worktree" "$root" \
                || die "registered worktree is invalid: $linked_worktree"
            wt="$linked_worktree"
            printf 'reusing existing worktree %s\n' "$wt" >&2
        else
            run git -C "$root" worktree add --quiet "$wt" "$name"
        fi
    else
        run git -C "$root" worktree add --quiet "$wt" -b "$name" "$base"
    fi
    $DRY_RUN || lfs_guard "$wt"

    if $DRY_RUN; then
        if [ -n "$CONFIG_DIR" ]; then
            cmd=$(printf 'env CLAUDE_CONFIG_DIR=%s %s --plugin-dir %s' \
                "$(shell_quote "$CONFIG_DIR")" \
                "$(shell_quote "$WRAPPER")" \
                "$(shell_quote "$VENDOR")")
        else
            cmd=$(printf '%s --plugin-dir %s' \
                "$(shell_quote "$WRAPPER")" "$(shell_quote "$VENDOR")")
        fi
        for argument in "$@"; do
            cmd="$cmd $(shell_quote "$argument")"
        done

        printf '\nworktree : %s\n' "$wt"
        printf 'ponytail : %s (pinned, audited)\n' "${PONYTAIL_SHA:0:12}"
        printf 'dry run  : no cache, branch, or worktree was created; the command below is illustrative\n'
        printf 'remove   : git -C %s worktree remove %s\n' \
            "$(shell_quote "$root")" "$(shell_quote "$wt")"
        printf '\nrun this in the window you want it in:\n\n  cd %s && %s\n\n' \
            "$(shell_quote "$wt")" "$cmd"
        return 0
    fi

    cd "$wt" || die "could not enter worktree: $wt"
    if [ -n "$CONFIG_DIR" ]; then
        exec env CLAUDE_CONFIG_DIR="$CONFIG_DIR" \
            "$WRAPPER" --plugin-dir "$VENDOR" "$@"
    fi
    exec "$WRAPPER" --plugin-dir "$VENDOR" "$@"
}

while [ $# -gt 0 ]; do
    case "$1" in
        --complete-worktrees)
            completion_worktree_names
            exit 0
            ;;
        --dry-run) DRY_RUN=true; shift ;;
        -h|--help) sed -n '2,22p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        -*)        die "unknown option: $1" ;;
        *)         NAME="$1"; shift; break ;;
    esac
done

[ -n "${NAME:-}" ] || die "need a worktree name. Try --help"
main "$NAME" "$@"
