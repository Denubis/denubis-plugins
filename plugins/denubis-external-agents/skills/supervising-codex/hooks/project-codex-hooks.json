{
  "description": "Wake the same-window Codex supervision monitor. Trust with /hooks in Codex after installing or changing this file, then restart any running Codex session.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --no-config python \"$HOME/.claude/plugins/marketplaces/denubis-plugins/plugins/denubis-external-agents/scripts/codex_supervisor.py\" --hook",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --no-config python \"$HOME/.claude/plugins/marketplaces/denubis-plugins/plugins/denubis-external-agents/scripts/codex_supervisor.py\" --hook",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --no-config python \"$HOME/.claude/plugins/marketplaces/denubis-plugins/plugins/denubis-external-agents/scripts/codex_supervisor.py\" --hook",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --no-config python \"$HOME/.claude/plugins/marketplaces/denubis-plugins/plugins/denubis-external-agents/scripts/codex_supervisor.py\" --hook",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --no-config python \"$HOME/.claude/plugins/marketplaces/denubis-plugins/plugins/denubis-external-agents/scripts/codex_supervisor.py\" --hook",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
