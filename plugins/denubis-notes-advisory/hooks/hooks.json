{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --no-config python \"${CLAUDE_PLUGIN_ROOT}/hooks/session-notes-advisory.py\"",
            "timeout": 10,
            "suppressOutput": true
          }
        ]
      }
    ]
  }
}
